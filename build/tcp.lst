 134:Middlewares/Third_Party/LwIP/src/core/tcp.c **** #define TCP_KEEP_INTVL(pcb) TCP_KEEPINTVL_DEFAULT
 135:Middlewares/Third_Party/LwIP/src/core/tcp.c **** #endif /* LWIP_TCP_KEEPALIVE */
